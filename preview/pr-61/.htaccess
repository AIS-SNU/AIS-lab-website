<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; script-src 'self' *.ais.snu.ac.kr; script-src-attr 'none'; style-src 'self' *.ais.snu.ac.kr https://fonts.googleapis.com https://cdn.jsdelivr.net; style-src-attr 'none'; font-src 'self' *.ais.snu.ac.kr https://fonts.gstatic.com data:; img-src 'self' *.ais.snu.ac.kr data:; connect-src 'self' https://api.github.com;"

    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "no-store, no-cache, must-revalidate, private"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>

Options -Indexes

ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^acsys\.snu\.ac\.kr$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://acsys.snu.ac.kr%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{REQUEST_METHOD} ^OPTIONS$
    RewriteRule ^ - [F,L]
</IfModule>
